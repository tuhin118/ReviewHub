:root {
  /* Black + Neon Green Cyber/Hacker Surface Hierarchy */
  --bg-canvas: #030605;
  --bg-surface: #070d0a;
  --bg-glass-primary: rgba(8, 15, 12, 0.86);
  --bg-glass-elevated: rgba(11, 20, 16, 0.94);
  --bg-glass-fallback: #0a120e;
  --bg-input: rgba(5, 10, 8, 0.92);

  /* Neon Green Primary Theme (No Blue Primary Accent) */
  --neon-green: #00ff88;
  --neon-green-soft: #10f5a0;
  --neon-green-dim: rgba(0, 255, 136, 0.14);
  --neon-green-tint: rgba(16, 245, 160, 0.08);
  --border-subtle: rgba(16, 245, 160, 0.16);
  --border-strong: rgba(0, 255, 136, 0.48);

  /* Typography Hierarchy (WCAG AA+ Contrast) */
  --text-primary: #f8fafc;
  --text-secondary: #d1ddd6;
  --text-muted: #93aba0;
  --text-on-neon: #030605;

  /* Semantic Indicators */
  --star-amber: #f59e0b;
  --status-warn: #f59e0b;
  --status-danger: #ff4d6d;

  /* Font Families */
  --font-display: 'Space Grotesk', 'Noto Sans Bengali', system-ui, -apple-system, sans-serif;
  --font-body: 'Inter', 'Noto Sans Bengali', system-ui, -apple-system, sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

  /* Layout & Radius */
  --container-max: 1320px;
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 18px;
  --radius-pill: 9999px;

  /* Subtle Depth & Elevation */
  --shadow-card: 0 10px 30px rgba(0, 0, 0, 0.48);
  --shadow-neon: 0 0 24px rgba(0, 255, 136, 0.14);
  --transition-fast: 180ms cubic-bezier(0.22, 1, 0.36, 1);
}
