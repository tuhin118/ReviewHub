interface ItemPreviewModalProps {
  item: CatalogItem | null;
  onClose: () => void;
}

export function ItemPreviewModal({ item, onClose }: ItemPreviewModalProps) {
  useEffect(() => {
    if (!item) return;
    const handleKeyDown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        onClose();
      }
    };
