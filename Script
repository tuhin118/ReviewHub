  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.main-content {
  flex: 1;
  padding-bottom: 5.5rem;
}

@media (min-width: 1024px) {
  .main-content {
    padding-bottom: 3rem;
  }
}

/* Navbar */
.navbar-wrap {
  position: sticky;
  top: 0;
  z-index: 40;
  background: rgba(3, 6, 5, 0.88);
  border-bottom: 1px solid var(--border-subtle);
}

@supports (backdrop-filter: blur(14px)) {
  .navbar-wrap {
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
}

.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  min-height: 68px;
}

.brand-link {
  display: inline-flex;
  align-items: center;
  gap: 0.65rem;
  min-height: 44px;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: rgba(0, 255, 136, 0.1);
  border: 1px solid var(--border-strong);
  box-shadow: var(--shadow-neon);
  color: var(--neon-green);
}

.brand-text {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}

.brand-name {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.brand-name span {
  color: var(--neon-green);
}

.brand-sub {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--text-muted);
  letter-spacing: 0.08em;
}

.nav-links {
  display: none;
  align-items: center;
  gap: 0.35rem;
}

.nav-link {
  padding: 0.5rem 0.85rem;
  border-radius: var(--radius-md);
  color: var(--text-secondary);
  font-size: 0.9rem;
  font-weight: 500;
  transition: color var(--transition-fast), background-color var(--transition-fast);
}

.nav-link:hover {
  color: var(--neon-green);
  background: var(--neon-green-tint);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.nav-guest-pill {
  display: none;
  align-items: center;
  gap: 0.4rem;
  padding: 0.32rem 0.7rem;
  border-radius: var(--radius-pill);
  border: 1px solid var(--border-subtle);
  background: rgba(16, 245, 160, 0.07);
  color: var(--neon-green-soft);
  font-family: var(--font-mono);
  font-size: 0.72rem;
}

.live-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--neon-green);
  box-shadow: 0 0 8px var(--neon-green);
}

.nav-auth-desktop {
  display: none;
  align-items: center;
  gap: 0.5rem;
}

.menu-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-subtle);
  background: var(--bg-glass-primary);
  color: var(--text-primary);
}

@media (min-width: 1024px) {
  .nav-links,
  .nav-guest-pill,
  .nav-auth-desktop {
    display: flex;
  }

  .menu-toggle {
    display: none;
  }
}

/* Mobile Slide-over Drawer */
.mobile-drawer-backdrop {
  position: fixed;
  inset: 0;
  z-index: 60;
  background: rgba(2, 4, 3, 0.78);
  display: flex;
  justify-content: flex-end;
}

.mobile-drawer {
  width: min(320px, 88vw);
  height: 100%;
  padding: 1.25rem;
  background: var(--bg-glass-elevated);
  border-left: 1px solid var(--border-strong);
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.mobile-drawer__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--border-subtle);
}

.mobile-drawer__nav {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.mobile-drawer__link {
  display: flex;
  align-items: center;
  min-height: 44px;
  padding: 0.6rem 0.85rem;
  border-radius: var(--radius-md);
  color: var(--text-secondary);
  font-weight: 500;
  border: 1px solid transparent;
}

.mobile-drawer__link:hover {
  color: var(--neon-green);
  background: var(--neon-green-tint);
  border-color: var(--border-subtle);
}

.mobile-drawer__footer {
  margin-top: auto;
  display: grid;
  gap: 0.6rem;
}

/* Mobile Thumb Bottom Bar */
.mobile-bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 45;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  background: rgba(4, 8, 6, 0.95);
  border-top: 1px solid var(--border-subtle);
  padding: 0.35rem 0.5rem calc(0.35rem + env(safe-area-inset-bottom));
}

.mobile-bottom-nav__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.2rem;
  min-height: 48px;
  color: var(--text-muted);
  font-size: 0.7rem;
  font-weight: 500;
  border-radius: var(--radius-sm);
}

.mobile-bottom-nav__item:hover {
  color: var(--neon-green);
}

@media (min-width: 1024px) {
  .mobile-bottom-nav {
    display: none;
  }
}

/* Non-blocking Guest Status Notice Toast */
.guest-toast {
  position: fixed;
  bottom: 5rem;
  right: 1rem;
  left: 1rem;
  z-index: 70;
  max-width: 440px;
  margin-inline: auto;
  padding: 0.85rem 1rem;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.75rem;
  border-color: var(--border-strong);
}

@media (min-width: 640px) {
  .guest-toast {
    left: auto;
    bottom: 1.5rem;
    right: 1.5rem;
  }
}

.guest-toast__text {
  font-size: 0.86rem;
  color: var(--text-secondary);
}

.guest-toast__title {
  display: block;
  color: var(--neon-green);
  font-family: var(--font-mono);
  font-size: 0.75rem;
  margin-bottom: 0.2rem;
}

.icon-btn-sm {
  min-width: 36px;
  min-height: 36px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-subtle);
  background: transparent;
  color: var(--text-secondary);
}

/* Hero Section */
.hero-section {
  padding: 2.25rem 0 2rem;
}

@media (min-width: 1024px) {
  .hero-section {
    padding: 3.75rem 0 2.75rem;
  }
}

.hero-shell {
  padding: 1.5rem;
  position: relative;
  overflow: hidden;
}

@media (min-width: 768px) {
  .hero-shell {
    padding: 2.5rem;
  }
}

@media (min-width: 1024px) {
  .hero-shell {
    padding: 3.25rem;
    display: grid;
    grid-template-columns: 1.35fr 0.85fr;
    gap: 2.25rem;
    align-items: center;
  }
}

.hero-eyebrow {
  margin-bottom: 1rem;
}

.hero-title {
  font-size: clamp(1.9rem, 4.2vw, 3.35rem);
  font-weight: 700;
  line-height: 1.12;
  margin-bottom: 1rem;
}

.hero-title__accent {
  color: var(--neon-green);
}

.hero-subtitle {
  color: var(--text-secondary);
  max-width: 60ch;
  margin-bottom: 1.5rem;
}

/* Search Bar */
.search-box {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-bottom: 1.15rem;
}

@media (min-width: 640px) {
  .search-box {
    flex-direction: row;
    align-items: stretch;
  }
}

.search-input-wrap {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
}

.search-icon {
  position: absolute;
  left: 0.95rem;
  color: var(--neon-green);
  pointer-events: none;
  display: inline-flex;
}

.search-input {
  width: 100%;
  min-height: 48px;
  padding: 0.7rem 2.75rem 0.7rem 2.75rem;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-subtle);
  background: var(--bg-input);
  color: var(--text-primary);
  font-size: 0.95rem;
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.search-input::placeholder {
  color: var(--text-muted);
}

.search-input:focus {
  border-color: var(--neon-green);
  box-shadow: 0 0 0 3px rgba(0, 255, 136, 0.14);
  outline: none;
}

.search-clear {
  position: absolute;
  right: 0.5rem;
  min-width: 36px;
  min-height: 36px;
  border: 0;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.06);
  color: var(--text-secondary);
  font-size: 1rem;
}

.hero-filter-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1.35rem;
}

.filter-pill {
  min-height: 38px;
  padding: 0.35rem 0.85rem;
  border-radius: var(--radius-pill);
  border: 1px solid var(--border-subtle);
  background: rgba(7, 13, 10, 0.85);
  color: var(--text-secondary);
  font-size: 0.84rem;
  font-weight: 500;
  transition: all var(--transition-fast);
}

.filter-pill:hover {
  border-color: var(--border-strong);
  color: var(--text-primary);
}

.filter-pill--active {
  background: var(--neon-green-dim);
  border-color: var(--neon-green);
  color: var(--neon-green);
}

.hero-ctas {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

/* Hero Right Telemetry Panel */
.hero-telemetry {
  margin-top: 1.75rem;
  padding: 1.25rem;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-subtle);
  background: rgba(4, 9, 7, 0.9);
  display: grid;
  gap: 0.9rem;
}

@media (min-width: 1024px) {
  .hero-telemetry {
    margin-top: 0;
  }
}

.telemetry-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--text-muted);
  border-bottom: 1px solid var(--border-subtle);
  padding-bottom: 0.6rem;
}

.telemetry-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.75rem;
}

.telemetry-stat {
  padding: 0.8rem;
  border-radius: var(--radius-sm);
  border: 1px solid rgba(16, 245, 160, 0.12);
  background: rgba(16, 245, 160, 0.04);
}

.telemetry-stat__value {
  display: block;
  font-family: var(--font-mono);
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--neon-green);
}

.telemetry-stat__label {
  font-size: 0.76rem;
  color: var(--text-secondary);
}

.telemetry-note {
  font-size: 0.78rem;
  color: var(--text-muted);
  line-height: 1.45;
}

/* Section Headers */
.section-block {
  padding: 1.75rem 0;
}

@media (min-width: 1024px) {
  .section-block {
    padding: 2.35rem 0;
  }
}

.section-header {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  margin-bottom: 1.25rem;
}

@media (min-width: 768px) {
  .section-header {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
  }
}

.section-kicker {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--neon-green);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 0.25rem;
}

.section-title {
  font-size: clamp(1.35rem, 2.5vw, 1.85rem);
  font-weight: 700;
}

.section-desc {
  color: var(--text-secondary);
  font-size: 0.92rem;
}

/* Trending Strip */
.trending-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.9rem;
}

@media (min-width: 640px) {
  .trending-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .trending-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.trending-card {
  padding: 1.1rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  transition: transform var(--transition-fast), border-color var(--transition-fast);
}

.trending-card:hover {
  transform: translateY(-2px);
  border-color: var(--border-strong);
}

.trending-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
}

.trend-delta {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--neon-green);
  background: var(--neon-green-dim);
  padding: 0.2rem 0.5rem;
  border-radius: var(--radius-pill);
}

/* Item Icon Box */
.item-icon-box {
  width: 44px;
  height: 44px;
  border-radius: 11px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  background: rgba(0, 255, 136, 0.09);
  border: 1px solid rgba(0, 255, 136, 0.28);
  color: var(--neon-green);
}

/* Categories Bento Grid */
.categories-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.9rem;
}

@media (min-width: 640px) {
  .categories-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .categories-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.category-card {
  width: 100%;
  text-align: left;
  padding: 1.15rem;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  transition: transform var(--transition-fast), border-color var(--transition-fast),
    background-color var(--transition-fast);
}

.category-card:hover {
  transform: translateY(-2px);
  border-color: var(--border-strong);
}

.category-card--active {
  border-color: var(--neon-green);
  background: rgba(10, 24, 17, 0.94);
  box-shadow: var(--shadow-neon);
}

.category-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
}

.category-card__code {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--neon-green);
}

.category-card__title {
  font-family: var(--font-display);
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--text-primary);
}

.category-card__desc {
  font-size: 0.86rem;
  color: var(--text-secondary);
}

.category-card__counts {
  margin-top: auto;
  padding-top: 0.45rem;
  display: flex;
  gap: 0.9rem;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--text-muted);
}

/* Featured Apps & Websites Bento Grid */
.active-filters-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1rem;
  padding: 0.75rem 1rem;
}

.featured-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
}

@media (min-width: 640px) {
  .featured-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .featured-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .featured-card--lead {
    grid-column: span 2;
  }
}

.item-card {
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
  transition: transform var(--transition-fast), border-color var(--transition-fast);
}

.item-card:hover {
  transform: translateY(-2px);
  border-color: var(--border-strong);
}

.item-card__header {
  display: flex;
  align-items: flex-start;
  gap: 0.85rem;
}

.item-card__meta {
  flex: 1;
  min-width: 0;
}

.item-card__badges {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-bottom: 0.4rem;
}

.item-card__title {
  font-size: 1.12rem;
  font-weight: 700;
  margin-bottom: 0.2rem;
}

.item-card__publisher {
  font-size: 0.8rem;
  color: var(--text-muted);
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
}

.verified-dot {
  color: var(--neon-green);
  font-weight: 700;
}

.item-card__desc {
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.55;
}

.item-card__footer {
  margin-top: auto;
  padding-top: 0.75rem;
  border-top: 1px solid rgba(16, 245, 160, 0.12);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
}

.rating-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-family: var(--font-mono);
  font-size: 0.85rem;
  font-weight: 600;
}

.rating-star {
  color: var(--star-amber);
}

.rating-count {
  color: var(--text-muted);
  font-weight: 400;
  font-size: 0.78rem;
}

/* Contextual Skeleton Card (Only during active demo reset/search) */
.skeleton-card {
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

.skeleton-line {
  height: 14px;
  border-radius: 6px;
  background: linear-gradient(
    90deg,
    rgba(16, 245, 160, 0.06) 25%,
    rgba(0, 255, 136, 0.14) 50%,
    rgba(16, 245, 160, 0.06) 75%
  );
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.2s infinite linear;
}

.skeleton-line--title {
  width: 60%;
  height: 20px;
}

.skeleton-line--short {
  width: 40%;
}

@keyframes skeleton-shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

/* Top Rated Leaderboard */
.top-rated-list {
  display: grid;
  gap: 0.8rem;
}

.top-rated-row {
  padding: 1rem 1.15rem;
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
  transition: border-color var(--transition-fast);
}

.top-rated-row:hover {
  border-color: var(--border-strong);
}

@media (min-width: 768px) {
  .top-rated-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
}

.top-rated-row__left {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  min-width: 0;
}

.rank-num {
  font-family: var(--font-mono);
  font-size: 1rem;
  font-weight: 700;
  color: var(--neon-green);
  min-width: 34px;
}

.top-rated-row__right {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

/* Empty State */
.empty-state {
  padding: 2.25rem 1.5rem;
  text-align: center;
  display: grid;
  gap: 0.75rem;
  justify-items: center;
}

/* Preview Modal */
.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(2, 5, 4, 0.82);
  display: grid;
  place-items: center;
  padding: 1rem;
}

.modal-card {
  width: min(640px, 100%);
  max-height: 90vh;
  overflow-y: auto;
  padding: 1.5rem;
  display: grid;
  gap: 1.1rem;
  border-color: var(--border-strong);
}

.modal-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
}

.review-preview-list {
  display: grid;
  gap: 0.7rem;
}

.review-preview-item {
  padding: 0.85rem;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-subtle);
  background: rgba(4, 9, 7, 0.8);
}

.review-preview-item__top {
  display: flex;
  justify-content: space-between;
  gap: 0.5rem;
  font-size: 0.82rem;
  margin-bottom: 0.35rem;
}

/* Footer */
.site-footer {
  margin-top: 2rem;
  border-top: 1px solid var(--border-subtle);
  background: rgba(4, 8, 6, 0.92);
  padding: 2rem 0 1.5rem;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
}

@media (min-width: 768px) {
  .footer-grid {
    grid-template-columns: 1.5fr 1fr 1fr;
  }
}

.footer-heading {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--neon-green);
  margin-bottom: 0.65rem;
}

.footer-links {
  display: grid;
  gap: 0.4rem;
  font-size: 0.88rem;
  color: var(--text-secondary);
}

.footer-links a:hover {
  color: var(--neon-green);
}

.footer-bottom {
  margin-top: 1.5rem;
  padding-top: 1rem;
  border-top: 1px solid rgba(16, 245, 160, 0.12);
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  font-size: 0.8rem;
  color: var(--text-muted);
}

@media (min-width: 768px) {
  .footer-bottom {
    flex-direction: row;
