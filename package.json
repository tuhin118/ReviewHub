{
  "name": "reviewhub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pages": "npx wrangler pages dev dist --port 8788",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:migrate:local": "npx wrangler d1 migrations apply reviewhub-db --local",
    "db:migrate:remote": "npx wrangler d1 migrations apply reviewhub-db --remote"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250401.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.8.3",
    "vite": "^8.0.0",
    "wrangler": "^4.0.0"
  }
}
