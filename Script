.cyber-bg {
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  overflow: hidden;
  background:
    radial-gradient(circle at 18% 12%, rgba(0, 255, 136, 0.11), transparent 44%),
